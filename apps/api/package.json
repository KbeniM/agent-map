    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@agent-map/shared": "workspace:*",
    "@hono/bun": "1.0.1",
    "@hono/zod-validator": "0.9.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
