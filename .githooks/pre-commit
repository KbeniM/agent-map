#!/usr/bin/env bun
import { $ } from "bun";

for (const run of [
  () => $`bunx biome check --staged --no-errors-on-unmatched`,
  () => $`bun scripts/lint.ts`,
  () => $`bun run typecheck`,
]) {
  const { exitCode } = await run().nothrow();
  if (exitCode !== 0) process.exit(exitCode);
}

const audit = await $`bunx fallow audit --format json --quiet --explain --gate-marker agent`
  .nothrow()
  .quiet();
const report = JSON.parse(audit.stdout.toString() || "{}");
if (report.verdict === "fail") {
  console.error(audit.stdout.toString());
  console.error("fallow audit failed: fix the findings above, then commit again.");
  process.exit(1);
}
