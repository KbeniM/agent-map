# Bridge (apps/api)
HOST=127.0.0.1
BRIDGE_PORT=4000
WEB_ORIGIN=http://localhost:5173
# Required when HOST is not loopback. Clients send it as "Authorization: Bearer <token>".
RANCHER_TOKEN=
# Event database and settings.json. Defaults to ~/.rancher
DATA_DIR=
# Serve the built web app from this folder (production)
STATIC_DIR=
# Replay transcripts touched in the last N hours, keep events for N days
SINCE_HOURS=24
RETENTION_DAYS=7
# Per-adapter folder overrides, e.g. CLAUDE_CODE_PATH=~/.claude/projects, CODEX_PATH=~/.codex/sessions

# Web (apps/web). Empty means "same origin as the page".
VITE_BRIDGE_URL=http://localhost:4000
